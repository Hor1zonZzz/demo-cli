# 示例配置文件（复制为 .env 并填写真实值）

# ===== 认证 =====
# DeepSeek API Key
DEEPSEEK_API_KEY=your_api_key_here

# ===== 模型选择 =====
# 使用的模型名称（当前默认 deepseek-chat）
MODEL_NAME=deepseek-chat

# ===== 上下文压缩 =====
# 模型最大上下文长度（token），用于判断何时触发压缩
MODEL_MAX_CONTEXT_TOKENS=128000

# 当已用上下文达到该比例时触发压缩（0~1）
CONTEXT_COMPRESSION_THRESHOLD=0.8

# 压缩时保留最近 N 条“非工具消息”的原文，其余合并为摘要
# 显式设置为 0，那么会把所有非工具历史压缩为 summary
CONTEXT_COMPRESSION_KEEP_LAST_MESSAGES=6
